{
  "name": "shotski",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @shotski/api",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start -w @shotski/api"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
